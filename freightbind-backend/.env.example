# FreightBind AI backend environment template.
# Copy to .env and fill in real values. Never commit a real .env.
#
# Core
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/freightbind
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000

# AI infrastructure (Phase 8 Part 1)
# AI_PROVIDER=mock          # "mock" (no key needed) or "openai"
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=               # required only for provider=openai
# AI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=1
# AI_CACHE_TTL_MS=300000
# AI_CACHE_MAX_ENTRIES=100
